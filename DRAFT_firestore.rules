rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // Validation for User entity
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'createdAt', 'lastActive']) &&
             data.keys().size() <= 7 && // Allowing for optional photoURL
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.createdAt is timestamp &&
             data.lastActive is timestamp;
    }

    // Validation for ChatMessage entity
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'role', 'text', 'timestamp', 'mode']) &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() <= 10000 &&
             data.mode is string && data.mode.size() <= 50 &&
             data.timestamp is timestamp;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.lastActive == request.time &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'lastActive']);
    }

    // User messages
    match /users/{userId}/messages/{messageId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidMessage(request.resource.data) && 
                      request.resource.data.timestamp == request.time &&
                      exists(/databases/$(database)/documents/users/$(userId));
      allow update: if false; // Messages are immutable
      allow delete: if isOwner(userId);
    }
  }
}

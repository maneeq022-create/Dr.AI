rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
       return isSignedIn() && 
              request.auth.token != null &&
              'email' in request.auth.token && 
              (request.auth.token.email == 'maneeq022@gmail.com' || request.auth.token.email == 'mpervaiz220@gmail.com');
    }
    
    match /admins/{email} {
      allow read, write: if isAdmin();
    }
    
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /supportTickets/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /adminLogs/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /patients/{doc} {
      allow read, write: if isSignedIn();
    }

    match /transactions/{doc} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow write: if isSignedIn();
    }

    match /safepayTransactions/{doc} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow write: if isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isEmailVerified() {
      // Relaxing this to allow all signed-in users for now
      return isSignedIn();
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'createdAt', 'lastActive']) &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.createdAt is timestamp &&
             data.lastActive is timestamp;
    }

    function isValidMessage(data) {
      // 'id' is a document ID, not part of the record data when using addDoc
      return data.keys().hasAll(['role', 'text', 'timestamp', 'mode']) &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() <= 30000 &&
             data.mode is string && data.mode.size() <= 100 &&
             data.timestamp is timestamp;
    }

    // Master Gates
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isEmailVerified();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if false; // Immutable messages
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Saved Chats Subcollection
      match /saved_chats/{chatId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
      }
    }
  }
}
